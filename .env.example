# ==========================================
# TON Gift Terminal Pro — Конфігурація (.env)
# ==========================================

# --- Загальні налаштування ---
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/terminal.db
DRY_RUN=True

# --- Telegram Бот та Mini App ---
# Отримай токен у @BotFather
TG_BOT_TOKEN=
# Твій Telegram ID (можна дізнатись у @userinfobot)
TG_ADMIN_CHAT_ID=
# Публічний HTTPS URL твого Mini App (через ngrok / Cloudflare Tunnel / VPS домен)
WEBAPP_URL=https://your-miniapp-domain.com

# --- API Ключі та Сесії Маркетів (опціонально) ---
# Portals і Getgems базові дані працюють ОДРАЗУ БЕЗ КЛЮЧІВ!
# Додай ключі/initData для повного доступу до оферів, закритих маркетів та автопокупки:
GETGEMS_API_KEY=
PORTALS_INIT_DATA=
MRKT_INIT_DATA=
TONNEL_INIT_DATA=

# --- Ризик-менеджмент ---
DAILY_LIMIT_TON=150.0
MAX_SINGLE_BUY_TON=40.0
STOP_LOSS_PERCENT=20.0
WALLET_ADDRESS=
